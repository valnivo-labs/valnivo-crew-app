{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valnivo Crew",
  "version": "0.17.2",
  "identifier": "eu.valnivo.crew",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Your always-on agents, their chats, rooms, runs and approvals",
    "copyright": "Valnivo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwRDQwRkY5NzE2RkNCQkYKUldTL3kyOXgrUS9VQVBvUkY3QlkwcWpVSUUwU1BSTEQ0ZFBCYmNvNC95NW9YbEwxODRoMThxNHkK",
      "endpoints": [
        "https://github.com/valnivo-labs/valnivo-crew-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
